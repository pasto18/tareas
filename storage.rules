rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function hasAccess() {
      return signedIn() && (
        request.auth.token.email == 'lisandromarq18@gmail.com'
        || firestore.exists(/databases/(default)/documents/allowed/$(request.auth.token.email))
      );
    }

    // Fotos: users/{uid}/tasks/{taskId}/{archivo}. Solo su dueño (y si sigue invitado).
    // La app las comprime a ~100 KB; aquí se limita a 400 KB y a imágenes para acotar el gasto.
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if request.auth.uid == userId && hasAccess();
      allow create, update: if request.auth.uid == userId && hasAccess()
        && request.resource.size < 400 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
    }
  }
}
